---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="项目" description="hangdah 的开源项目。">
  <header class="page-heading">
    <h1>项目</h1>
    <p>一些仍在维护或值得记录的开源项目。</p>
  </header>

  <section aria-labelledby="project-list-title">
    <div class="section-heading">
      <h2 id="project-list-title">精选项目</h2>
      <a
        class="text-link"
        href="https://github.com/hangdah"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
    </div>
    <div
      id="project-list"
      class="project-list"
      aria-live="polite"
      aria-busy="true"
    >
      <p class="loading-state">正在加载项目…</p>
    </div>
  </section>
</BaseLayout>

<script>
  import "../../../assets/js/site.js";
</script>
